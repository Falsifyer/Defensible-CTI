{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Falsifyer/Defensible-CTI/main/packages/cti-method/src/cti_method/schemas/assessment.schema.json",
  "title": "Graded assessment (dossier or claim)",
  "description": "One body of evidence, at least two competing hypotheses and a declared grade. `judgement.confidence` is required on purpose: there is no silent default, and `assessment assess` refuses a claim that declares no grade.",
  "type": "object",
  "required": ["schema_version", "id", "question", "hypotheses", "evidence", "judgement"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "requirement_id": { "type": "string", "minLength": 1, "description": "The PIR this answers." },
    "question": { "type": "string", "minLength": 1 },
    "tlp": { "type": "string", "pattern": "^TLP:(CLEAR|GREEN|AMBER|AMBER\\+STRICT|RED)$" },
    "review_by": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "review_trigger": { "type": "string" },
    "gaps": { "type": "array", "items": { "type": "string" } },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["vendor", "name"],
        "properties": {
          "vendor": { "type": "string" },
          "name": { "type": "string" },
          "source_url": { "type": "string" },
          "date": { "type": "string" },
          "tlp": { "type": "string" }
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "minItems": 2,
      "description": "At least two: one option is not analysis.",
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "source", "type", "consistency"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "type": {
            "enum": ["infrastructure", "code", "operator", "tactics", "linguistic", "structural", "open_source"],
            "description": "Only infrastructure, code and operator can carry an identity claim; the rest are non-diagnostic."
          },
          "consistency": {
            "type": "object",
            "additionalProperties": { "enum": ["C", "I", "0"] },
            "description": "C consistent, I inconsistent, 0 neutral. A hypothesis not addressed is neutral, not support."
          }
        }
      }
    },
    "judgement": {
      "type": "object",
      "required": ["confidence"],
      "properties": {
        "confidence": { "enum": ["high", "moderate", "low"] },
        "probability": {
          "enum": ["nearly_certain", "very_likely", "likely", "roughly_even_chance", "unlikely", "very_unlikely"]
        },
        "probability_of": { "type": "string", "minLength": 1, "description": "The proposition the probability is about." }
      }
    },
    "adjudication": {
      "type": "object",
      "required": ["truth"],
      "properties": {
        "truth": { "enum": ["same_actor", "distinct", "contested", "unadjudicated"] },
        "standard": {
          "enum": ["author-assertion", "single-source", "vendor-consensus", "government-statement", "independent-corroboration"]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["publisher", "category", "kind"],
            "properties": {
              "publisher": { "type": "string" },
              "url": { "type": "string" },
              "category": { "enum": ["government", "vendor", "community", "osint"] },
              "kind": { "enum": ["asserts-same", "asserts-distinct", "overlap", "silent"] },
              "derived_from": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "adjudicators": { "type": "array", "items": { "type": "string" } },
        "disagreements": { "type": "array", "items": { "type": "string" } },
        "decided_at": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
