{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Falsifyer/Defensible-CTI/main/packages/cti-method/src/cti_method/schemas/pir.schema.json",
  "title": "PIR register",
  "description": "A register of requirements. A requirement that does not name the decision it informs is not a PIR; the schema requires the field, and `pir validate` checks that it is usable.",
  "type": "object",
  "required": ["schema_version", "id", "requirements"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "minLength": 1, "description": "Register identifier, e.g. PIR-2026-Q4." },
    "version": { "type": "string" },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirement" }
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "required": ["id", "question", "decision", "consumer", "priority", "eei"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "decision": { "type": "string", "minLength": 1, "description": "The decision this answer informs." },
        "consumer": { "type": "string", "minLength": 1, "description": "Who takes that decision, by name." },
        "priority": { "enum": ["high", "medium", "low"] },
        "deadline": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "status": { "enum": ["open", "answered", "cancelled"] },
        "eei": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "question", "indicators"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "question": { "type": "string", "minLength": 1 },
              "indicators": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["value", "source"],
                  "properties": {
                    "value": { "type": "string", "minLength": 1 },
                    "source": {
                      "type": "string",
                      "pattern": "^[A-F][1-6]$",
                      "description": "Admiralty grade: source reliability A-F, information credibility 1-6."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
