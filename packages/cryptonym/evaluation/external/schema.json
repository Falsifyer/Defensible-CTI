{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Falsifyer/Defensible-CTI/main/packages/cryptonym/evaluation/external/schema.json",
  "title": "Cryptonym external adjudicated corpus",
  "description": "A case enters this corpus only after two independent adjudicators and an independent source graph. See PROTOCOL.md.",
  "type": "object",
  "required": ["corpus", "schema_version", "protocol_version", "cases"],
  "properties": {
    "corpus": { "const": "external" },
    "schema_version": { "const": "1.0" },
    "protocol_version": { "type": "string", "minLength": 1 },
    "note": { "type": "string" },
    "cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "designation": {
      "type": "object",
      "required": ["vendor", "name"],
      "properties": {
        "vendor": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["id", "statement", "source", "type", "consistency"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string" },
        "reliability": { "enum": ["A", "B", "C", "D", "E", "F", ""] },
        "direct": { "type": "boolean" },
        "artifact": {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": { "enum": ["hash", "domain", "url", "ip", "certificate", "pattern", "handle", "other"] },
            "value": { "type": "string", "minLength": 1 },
            "source": { "type": "string", "minLength": 1 }
          }
        },
        "type": {
          "enum": ["infrastructure", "code", "operator", "tactics", "linguistic", "structural", "open_source"]
        },
        "consistency": {
          "type": "object",
          "additionalProperties": { "enum": ["C", "I", "0"] }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["type"],
            "properties": { "type": { "enum": ["infrastructure", "code", "operator"] } }
          },
          "then": { "required": ["artifact"] }
        }
      ]
    },
    "source": {
      "type": "object",
      "required": ["publisher", "url", "category", "kind", "accessed_at", "snapshot_sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "category": { "enum": ["government", "vendor", "community", "osint"] },
        "kind": { "enum": ["asserts-same", "asserts-distinct", "overlap", "silent"] },
        "reliability": { "enum": ["A", "B", "C", "D", "E", "F", ""] },
        "derived_from": { "type": "array", "items": { "type": "string" } },
        "accessed_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "snapshot_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "evidence_source": {
      "allOf": [
        { "$ref": "#/$defs/source" },
        { "required": ["id"] }
      ]
    },
    "adjudication": {
      "type": "object",
      "required": ["truth", "adjudicators", "decided_at"],
      "properties": {
        "truth": { "enum": ["same_actor", "distinct", "contested", "unadjudicated"] },
        "standard": {
          "enum": ["author-assertion", "single-source", "vendor-consensus", "government-statement", "independent-corroboration"]
        },
        "adjudicators": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "disagreements": { "type": "array", "items": { "type": "string" } },
        "decided_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "note": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "required": ["truth"],
            "properties": { "truth": { "enum": ["same_actor", "distinct"] } }
          },
          "then": {
            "required": ["standard", "sources"],
            "properties": {
              "adjudicators": { "minItems": 2 },
              "sources": { "minItems": 2 }
            }
          }
        }
      ]
    },
    "case": {
      "type": "object",
      "required": ["id", "split", "question", "subjects", "evidence", "sources", "adjudication"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "split": { "enum": ["development", "held-out"] },
        "question": { "type": "string", "minLength": 1 },
        "subjects": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/designation" }
        },
        "judgement": {
          "type": "object",
          "properties": {
            "confidence": { "enum": ["high", "moderate", "low"] },
            "probability": {
              "enum": ["nearly_certain", "very_likely", "likely", "roughly_even_chance", "unlikely", "very_unlikely"]
            },
            "probability_of": { "type": "string" }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence_source" }
        },
        "adjudication": { "$ref": "#/$defs/adjudication" }
      }
    }
  }
}
